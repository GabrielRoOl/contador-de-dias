# Copie para .env (que o git ignora) e preencha. Variáveis de ambiente de verdade têm prioridade sobre este arquivo.
# As chaves VAPID saem de: java -jar contador.jar gerar-vapid   (a privada é segredo, nunca vai para o git)
VAPID_PUBLIC=
VAPID_PRIVATE=
# Contato exigido pelo protocolo Web Push (uma URL, para não expor e-mail)
VAPID_SUBJECT=https://grodev.com.br/contador

PORT=8090
BIND=127.0.0.1
DB_PATH=contador.db
# Pasta com o app (a public/ do repositório). Padrão: ../public
STATIC_DIR=../public
MAX_DISPOSITIVOS=10000
# Soma máxima dos estados guardados, em MB
MAX_BYTES_MB=200
